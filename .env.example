# Lify — variables d'environnement
# Copier ce fichier en .env.local puis remplir les valeurs depuis votre projet Supabase.

# Clés publiques (safe côté navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE-CLE-ANON

# URL du site (utilisée pour les liens de confirmation d'email et la redirection OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
